# Requerido: app id de dashboard.privy.io (login email + Google + embedded wallet on login)
NEXT_PUBLIC_PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID

# Opcional, override del RPC público (con API key el historial de actividad puede cubrir más de 48 h)
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_ETHEREUM=

# Opcional, override del FaroYieldRegistry (contracts-yield/), procedencia del yield.
# Addresses públicas, no secretas. Fallback en deployments.json si se omiten.
NEXT_PUBLIC_REGISTRY_1_LABEL=Rendimiento (yield)
NEXT_PUBLIC_REGISTRY_1_ADDRESS=0x06282d1a04be98f400387f3965704f8846d7fefb
NEXT_PUBLIC_REGISTRY_1_CHAIN_ID=42161
NEXT_PUBLIC_REGISTRY_1_DEPLOY_BLOCK=496520325

# Requerido (Phase 3, modo Cuenta): Postgres del ledger, Vercel Storage → Marketplace → Neon
DATABASE_URL=

# Requerido (Phase 3): dashboard.privy.io → app de Phase 1 → App secret (verifica access tokens server-side)
PRIVY_APP_SECRET=

# Requerido (Phase 3, retiros 03-02): clave privada de la bóveda omnibus, solo server, solo demo (SPEC §7.7)
VAULT_PRIVATE_KEY=

# Requerido (Phase 3, cron de interés 03-03): protege el endpoint manual de interés
CRON_SECRET=

# Requerido (Phase 4, opening/verificación SOL-04): hex de 32 bytes, deriva el salt de cada
# usuario via HKDF(master, did). Solo env de Vercel, JAMAS un valor real acá ni en ningun commit.
SOBRECITO_MASTER_HEX=

# Requerido (pipeline de corte de yield, lib/sobrecito-mini/prove-yield.ts): clave privada
# del publisher, firma la publicación al FaroYieldRegistry.
# Solo env de Vercel, JAMAS un valor real acá ni en ningun commit.
PUBLISHER_PRIVATE_KEY=
