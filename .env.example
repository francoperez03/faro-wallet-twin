# Requerido: app id de dashboard.privy.io (login email + Google + embedded wallet on login)
NEXT_PUBLIC_PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID

# Opcional, override del RPC público
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_POLYGON=

# Opcional, override del SobrecitoRegistry (Phase 2). Addresses públicas, no secretas.
# Fallback en deployments.json si se omiten.
NEXT_PUBLIC_REGISTRY_1_LABEL=Fixture sintética
NEXT_PUBLIC_REGISTRY_1_ADDRESS=0x89ec9bf3cd42a037a2d004813733fc0d6e2ab03d
NEXT_PUBLIC_REGISTRY_1_CHAIN_ID=42161

# Opcional, override del segundo Registry (Phase 4, 04-03, corte mini). Fallback en
# deployments.json si se omiten.
NEXT_PUBLIC_REGISTRY_2_LABEL=Corte real (mini)
NEXT_PUBLIC_REGISTRY_2_ADDRESS=0x34d16b00809fcc6a6b0855d2052708615dbdc2c7
NEXT_PUBLIC_REGISTRY_2_CHAIN_ID=42161

# Opcional, override del tercer Registry (pivote de yield, contracts-yield/FaroYieldRegistry).
# Fallback en deployments.json si se omiten.
NEXT_PUBLIC_REGISTRY_3_LABEL=Rendimiento (yield)
NEXT_PUBLIC_REGISTRY_3_ADDRESS=0x06282d1a04be98f400387f3965704f8846d7fefb
NEXT_PUBLIC_REGISTRY_3_CHAIN_ID=42161

# Requerido (Phase 3, modo Cuenta): Postgres del ledger, Vercel Storage → Marketplace → Neon
DATABASE_URL=

# Requerido (Phase 3): dashboard.privy.io → app de Phase 1 → App secret (verifica access tokens server-side)
PRIVY_APP_SECRET=

# Requerido (Phase 3, retiros 03-02): clave privada de la bóveda omnibus, solo server, solo demo (SPEC §7.7)
VAULT_PRIVATE_KEY=

# Requerido (Phase 3, cron de interés 03-03): protege el endpoint manual de interés
CRON_SECRET=

# Requerido (Phase 4, opening/verificación SOL-04): hex de 32 bytes, deriva el salt de cada
# usuario via HKDF(master, did). Solo env de Vercel, JAMAS un valor real acá ni en ningun commit.
SOBRECITO_MASTER_HEX=

# Requerido (Phase 4, 04-03 stretch, pipeline de corte mini): clave privada del publisher
# (misma wallet M2 que firma el publish de Phase 2), firma la publicación al Registry #2.
# Solo env de Vercel, JAMAS un valor real acá ni en ningun commit.
PUBLISHER_PRIVATE_KEY=
